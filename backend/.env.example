# ============================================================
# MineSafe AI Backend — Environment Configuration
# ============================================================

# Database Connection (Replace with your PostgreSQL password and DB name)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/minesafe

# Security / JWT
SECRET_KEY=change-this-secret-key-in-production-must-be-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Frontend Origin
FRONTEND_ORIGIN=http://localhost:5173

# Application
APP_ENV=development
APP_NAME=MineSafe AI
API_V1_PREFIX=/api/v1
