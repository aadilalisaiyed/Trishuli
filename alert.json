        "html": "==<div style=\"font-family: Arial, sans-serif; padding: 20px; border: 2px solid #e53e3e; border-radius: 8px; background-colour: #fff5f5; colour: #2d3748;\">\n  <h2 style=\"colour: #c53030; margin-top: 0; border-bottom: 2px solid #feb2b2; padding-bottom: 8px; text-transform: uppercase;\">\n    ⚠️ Critical Safety Evacuation Notice\n  </h2>\n  \n  <p style=\"font-size: 1.1em; colour: #1a202c; font-weight: bold; line-height: 1.6; background-colour: #fed7d7; padding: 12px; border-radius: 6px; border-left: 4px solid #e53e3e;\">\n    {{ $('Message Formatter').item.json.evacuation_instruction }}\n  </p>\n  \n  <hr style=\"border: none; border-top: 1px solid #e2e8f0; margin: 18px 0;\" />\n  \n  <h3 style=\"colour: #2b6cb0; margin-top: 0; font-size: 1em;\">Telemetry & Location Details:</h3>\n  <ul style=\"list-style-type: none; padding-left: 0; line-height: 1.8;\">\n    <li><strong>Affected Node ID:</strong> <span style=\"colour: #c53030; font-weight: bold;\">{{ $('Message Formatter').item.json.affected_node.id }}</span></li>\n    <li><strong>Alert Type:</strong> {{ $('Message Formatter').item.json.affected_node.alert_type }}</li>\n    <li><strong>Source Coordinates:</strong> Lat <code>{{ $('Message Formatter').item.json.affected_node.latitude }}</code>, Lon <code>{{ $('Message Formatter').item.json.affected_node.longitude }}</code></li>\n    <li><strong>Target Safe Zone Node:</strong> <span style=\"colour: #2f855a; font-weight: bold;\">{{ $('Message Formatter').item.json.safe_zone_node.id }}</span></li>\n    <li><strong>Safe Zone Status:</strong> {{ $('Message Formatter').item.json.safe_zone_node.health_status }}</li>\n    <li><strong>Calculated Distance:</strong> {{ $('Message Formatter').item.json.safe_zone_node.distance_meters }} meters</li>\n  </ul>\n  \n  <p style=\"font-size: 0.85em; colour: #718096; margin-top: 20px;\">\n    This is an automated real-time alert dispatched by the MineSafe AI Geotechnical Surveillance System.\n  </p>\n</div>",
