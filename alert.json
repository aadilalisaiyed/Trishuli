        "jsCode": "return $input.all().map((item) => {\n  const data = item.json;\n  const affectedNode = data.affected_node || { id: \"NODE_04\", latitude: 23.2156, longitude: 72.6369 };\n  const safeZone = data.safe_zone_node || { id: \"NODE_12\", latitude: 23.2198, longitude: 72.6412 };\n\n  const subject = `CRITICAL SAFETY ALERT: Node ${affectedNode.id} - Evacuate Immediately`;\n  const body = `ALERT at node ${affectedNode.id} at latitude ${affectedNode.latitude} and longitude ${affectedNode.longitude}. If you are present nearby, evacuate immediately to Safe Zone ${safeZone.id} at latitude ${safeZone.latitude} and longitude ${safeZone.longitude}.`;\n\n  return {\n    json: {\n      ...data,\n      affected_node: affectedNode,\n      safe_zone_node: safeZone,\n      alert_subject: subject,\n      alert_body: body,\n      evacuation_instruction: data.evacuation_instruction || body\n    }\n  };\n});"
